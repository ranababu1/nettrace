<Window x:Class="NetTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetTrace.App.ViewModels"
        xmlns:local="clr-namespace:NetTrace.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/NetTrace.ico"
        Width="820" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24" MaxWidth="920">

            <!-- Header -->
            <DockPanel Margin="0,0,0,18" LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/NetTrace.png" Width="28" Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" AutomationProperties.Name="NetTrace logo" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource AppTitleTextStyle}" />
                <Border DockPanel.Dock="Left" Style="{StaticResource ChipBorderStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,2">
                    <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource CaptionTextStyle}" />
                </Border>
            </DockPanel>

            <!-- Hero status -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Glyph plus text label: state is never conveyed by colour alone. -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top" Margin="0,0,18,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="{Binding MonitoringStateGlyph}" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   AutomationProperties.Name="Monitoring state icon" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding MonitoringState}" Style="{StaticResource HeroTitleTextStyle}" />
                        <TextBlock Text="{Binding MonitoringStateDescription}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Style="{StaticResource CaptionTextStyle}" FontSize="13" />
                        <WrapPanel>
                            <Border Style="{StaticResource ChipBorderStyle}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                    <TextBlock Text="{Binding ConnectionText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}" Margin="0,0,8,6"
                                    ToolTip="The most recent time any check received a reply.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                    <TextBlock Text="{Binding LastSuccessText, StringFormat=Last reply {0}}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding HasLastError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live tiles -->
            <WrapPanel Margin="0,0,-12,0">
                <Border Style="{StaticResource TileBorderStyle}"
                        ToolTip="Data your PC is receiving right now, read from Windows adapter counters. This is usage, not your plan's available speed; low values while idle are normal.">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                            <TextBlock Text="Download" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding DownloadValue}" Style="{StaticResource TileValueTextStyle}" />
                            <TextBlock Text="{Binding DownloadUnit}" Style="{StaticResource TileUnitTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThroughputCaption}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileBorderStyle}"
                        ToolTip="Data your PC is sending right now, read from Windows adapter counters.">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                            <TextBlock Text="Upload" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="{Binding UploadValue}" Style="{StaticResource TileValueTextStyle}" />
                            <TextBlock Text="{Binding UploadUnit}" Style="{StaticResource TileUnitTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThroughputCaption}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileBorderStyle}"
                        ToolTip="Round-trip time of an ICMP echo to your router (default gateway). Windows reports whole milliseconds.">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                            <TextBlock Text="Router" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RouterLatency}" Style="{StaticResource TileValueTextStyle}" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding RouterCaption}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileBorderStyle}"
                        ToolTip="Average round-trip time of ICMP echoes to the external targets that replied in the latest check.">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0" />
                            <TextBlock Text="Internet" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding InternetLatency}" Style="{StaticResource TileValueTextStyle}" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding InternetCaption}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Latest measurements -->
            <TextBlock Text="Latest checks" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <TextBlock Text="No measurements yet." Style="{StaticResource CaptionTextStyle}" Margin="20,16">
                        <TextBlock.Visibility>
                            <Binding Path="LatestMeasurements.Count">
                                <Binding.Converter>
                                    <local:ZeroToVisibleConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding LatestMeasurements}" AutomationProperties.Name="Latest checks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProbeRowViewModel}">
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                   Margin="0,2,14,0" AutomationProperties.Name="Result icon" />
                                        <TextBlock Grid.Column="1" Text="{Binding Check}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                                   FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock Grid.Column="3" Text="{Binding Result}" TextWrapping="Wrap"
                                                   ToolTip="{Binding MeasuredAt, StringFormat=Measured at {0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid Margin="2,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                        <Run Text="Started" />
                        <Run Text="{Binding StartedAtText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"
                               ToolTip="Local database, logs and exports are stored here. Nothing is sent to the cloud.">
                        <Run Text="Data stored locally in" />
                        <Run Text="{Binding DataDirectory, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                            <TextBlock Text="Open data folder" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExitCommand}" ToolTip="Stop monitoring and close NetTrace. Closing the window keeps it running in the tray.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                            <TextBlock Text="Exit" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
