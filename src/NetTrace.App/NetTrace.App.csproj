<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetTrace.Core\NetTrace.Core.csproj" />
    <ProjectReference Include="..\NetTrace.Infrastructure\NetTrace.Infrastructure.csproj" />
    <ProjectReference Include="..\NetTrace.Reporting\NetTrace.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the system tray NotifyIcon, which WPF does not provide. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\NetTrace.ico</ApplicationIcon>
    <AssemblyTitle>NetTrace</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WinForms/WPF type-name clashes (Application, MessageBox, ...); WinForms types are referenced explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NetTrace.ico" />
    <Resource Include="Assets\NetTrace.png" />
  </ItemGroup>

</Project>
